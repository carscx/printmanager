# Supabase (usadas en src/config/supabase.ts)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App (informativo; la app no depende de esto para Supabase)
VITE_ENV=development

# ── Vite: orden de carga (las últimas definiciones ganan) ────────────────────
# .env  →  .env.local  →  .env.[development|production]  →  .env.[mode].local
#
# Si tenés .env.local con VITE_SUPABASE_URL, ese valor manda aunque cambies .env.
# Para alternar dev/prod desde un solo archivo: definí todo en .env y dejá
# .env.local solo con comentarios (ver .env.local en el repo) o borrá las
# variables duplicadas en .env.local.
